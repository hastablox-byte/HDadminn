-- LOCAL VEHICLE UTILITIES (only while seated in a vehicle)
local vehicleState = {Fly=false}
local vehicleObjects = {}
local function getVehicle()
    local h = humanoid()
    if not h then return nil end
    local seat = h.SeatPart
    if not seat then return nil end
    local model = seat:FindFirstAncestorOfClass("Model")
    return model, seat
end

local function vehicleSpeed(value)
    local model, seat = getVehicle()
    if not model or not seat then notify("Entre em um veículo primeiro"); return end
    local rootPart = model.PrimaryPart or seat
    local direction = rootPart.CFrame.LookVector
    local currentY = rootPart.AssemblyLinearVelocity.Y
    rootPart.AssemblyLinearVelocity = direction * math.clamp(value,0,250) + Vector3.new(0,currentY,0)
    notify("Velocidade local do veículo: "..tostring(value))
end

local function vehicleFly()
    vehicleState.Fly = not vehicleState.Fly
    stopConnection("VehicleFly")
    for _,obj in ipairs(vehicleObjects) do pcall(function() obj:Destroy() end) end
    table.clear(vehicleObjects)
    if not vehicleState.Fly then notify("VehicleFly desativado"); return end
    local model, seat = getVehicle()
    if not model or not seat then vehicleState.Fly=false; notify("Entre em um veículo primeiro"); return end
    local rootPart = model.PrimaryPart or seat
    local velocity = Instance.new("BodyVelocity")
    velocity.MaxForce = Vector3.new(1e6,1e6,1e6)
    velocity.Velocity = Vector3.zero
    velocity.Parent = rootPart
    local gyro = Instance.new("BodyGyro")
    gyro.MaxTorque = Vector3.new(1e6,1e6,1e6)
    gyro.P = 9000
    gyro.CFrame = rootPart.CFrame
    gyro.Parent = rootPart
    vehicleObjects = {velocity,gyro}
    connections.VehicleFly = RunService.RenderStepped:Connect(function()
        if not vehicleState.Fly or not rootPart.Parent then return end
        local camera = workspace.CurrentCamera
        local direction = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then direction += camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then direction -= camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then direction -= camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then direction += camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then direction += Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then direction -= Vector3.yAxis end
        velocity.Velocity = direction * 65
        gyro.CFrame = camera.CFrame
    end)
    notify("VehicleFly ativado — WASD / Espaço / Ctrl")
end

local spectating = false
local previousCameraSubject
local function findPlayer(query)
    query = tostring(query or ""):lower()
    if query == "" then return nil end
    if query == "me" then return LP end
    if query == "random" then
        local candidates={}
        for _,plr in ipairs(Players:GetPlayers()) do if plr ~= LP then table.insert(candidates,plr) end end
        return #candidates>0 and candidates[math.random(1,#candidates)] or LP
    end
    if query == "nearest" or query == "farthest" then
        local myRoot=root()
        if not myRoot then return nil end
        local chosen,best=nil,(query=="nearest" and math.huge or -math.huge)
        for _,plr in ipairs(Players:GetPlayers()) do
            local otherRoot=plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if plr ~= LP and otherRoot then
                local distance=(otherRoot.Position-myRoot.Position).Magnitude
                if (query=="nearest" and distance<best) or (query=="farthest" and distance>best) then
                    chosen,best=plr,distance
                end
            end
        end
        return chosen
    end
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower() == query or plr.DisplayName:lower() == query then return plr end
    end
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower():sub(1,#query) == query or plr.DisplayName:lower():sub(1,#query) == query then return plr end
    end
    return nil
end

local function teleportToPlayer(query)
    local target = findPlayer(query)
    local myRoot = root()
    local targetRoot = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not target or not targetRoot or not myRoot then notify("Jogador ou personagem não encontrado"); return end
    if target == LP then notify("Você já está nesse local"); return end
    myRoot.CFrame = targetRoot.CFrame * CFrame.new(3,0,0)
    notify("Teleporte local até "..target.Name)
end

local function viewPlayer(query)
    local target = findPlayer(query)
    local targetHumanoid = target and target.Character and target.Character:FindFirstChildOfClass("Humanoid")
    if not targetHumanoid then notify("Jogador ou personagem não encontrado"); return end
    local camera = workspace.CurrentCamera
    if not spectating then previousCameraSubject = camera.CameraSubject end
    spectating = true
    camera.CameraSubject = targetHumanoid
    notify("Visualizando "..target.Name.." — use ;unview")
end

local function unview()
    local camera = workspace.CurrentCamera
    camera.CameraSubject = humanoid() or previousCameraSubject
    previousCameraSubject = nil
    spectating = false
    notify("Câmera restaurada")
end

local function equipOwnedBoombox()
    local backpack = LP:FindFirstChildOfClass("Backpack")
    local c = character()
    local tool
    for _,container in ipairs({backpack,c}) do
        if container then
            for _,obj in ipairs(container:GetChildren()) do
                if obj:IsA("Tool") and obj.Name:lower():find("boombox",1,true) then tool=obj; break end
            end
        end
        if tool then break end
    end
    if not tool then notify("Nenhuma Boombox encontrada no seu inventário"); return end
    local h=humanoid()
    if h then h:EquipTool(tool); notify("Boombox equipada") end
end

local function restore()
    states.Fly=false; states.NoClip=false; states.InfiniteJump=false; vehicleState.Fly=false
    if clickTeleportConnection then clickTeleportConnection:Disconnect(); clickTeleportConnection=nil end
    unview()
    for _,obj in ipairs(vehicleObjects) do pcall(function() obj:Destroy() end) end
    table.clear(vehicleObjects)
    for name in pairs(connections) do stopConnection(name) end
    for _,obj in ipairs(flyObjects) do pcall(function() obj:Destroy() end) end
    table.clear(flyObjects)
    local h = humanoid()
    if h then
        h.WalkSpeed=16
        h.UseJumpPower=true
        h.JumpPower=50
        h.MaxHealth=100
        h.Health=100
    end
    for obj,data in pairs(original) do
        if obj and obj.Parent then
            obj.Size=data.Size
            obj.Material=data.Material
            obj.Color=data.Color
            obj.Transparency=data.Transparency
            obj.LocalTransparencyModifier=data.LocalTransparencyModifier
            obj.CanCollide=data.CanCollide
        end
    end
    local hd=head()
    if hd then
        local titleObj=hd:FindFirstChild("HDAdminTitle")
        if titleObj then titleObj:Destroy() end
    end
    notify("Configurações originais restauradas")
end


