local freecamState = {Enabled=false, Position=nil, Yaw=0, Pitch=0, OldType=nil, OldSubject=nil, OldMouseBehavior=nil}
local function freecam()
    local camera = workspace.CurrentCamera
    if not camera then return end
    if freecamState.Enabled then
        freecamState.Enabled=false
        stopConnection("Freecam")
        camera.CameraType=freecamState.OldType or Enum.CameraType.Custom
        camera.CameraSubject=freecamState.OldSubject or humanoid()
        UIS.MouseBehavior=freecamState.OldMouseBehavior or Enum.MouseBehavior.Default
        notify("Freecam desativado")
        return
    end
    freecamState.Enabled=true
    freecamState.Position=camera.CFrame.Position
    local look=camera.CFrame.LookVector
    freecamState.Yaw=math.atan2(-look.X,-look.Z)
    freecamState.Pitch=math.asin(math.clamp(look.Y,-1,1))
    freecamState.OldType=camera.CameraType
    freecamState.OldSubject=camera.CameraSubject
    freecamState.OldMouseBehavior=UIS.MouseBehavior
    camera.CameraType=Enum.CameraType.Scriptable
    UIS.MouseBehavior=Enum.MouseBehavior.LockCenter
    connections.Freecam=RunService.RenderStepped:Connect(function(dt)
        if not freecamState.Enabled then return end
        local delta=UIS:GetMouseDelta()
        freecamState.Yaw=freecamState.Yaw-delta.X*0.0025
        freecamState.Pitch=math.clamp(freecamState.Pitch-delta.Y*0.0025,-1.45,1.45)
        local rotation=CFrame.fromOrientation(freecamState.Pitch,freecamState.Yaw,0)
        local move=Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then move+=rotation.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then move-=rotation.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then move+=rotation.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then move-=rotation.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.E) then move+=Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.Q) then move-=Vector3.yAxis end
        freecamState.Position+=move*(45*dt)
        camera.CFrame=CFrame.new(freecamState.Position)*rotation
    end)
    notify("Freecam ativado — WASD / Q / E; mouse para olhar")
end

