local function executeChat(message)
    if message:sub(1,1) ~= ";" then return end
    local chunks = string.split(message, "\\")
    for _,chunk in ipairs(chunks) do
        chunk = chunk:match("^%s*(.-)%s*$") or chunk
        local args = string.split(chunk, " ")
        local command = (args[1] or ""):sub(2):lower()
        if command ~= "" then
            if command == "cmds" or command == "help" then
                notify("Comandos locais: fly/unfly, noclip/clip, ws, jp, goto, view, clicktp, esp, xray, fullbright, fov, freecam, swim, sit, stand, setspawn, spawnpoint, rejoin")
            else
                local fn = commands[command]
                if fn then
                    local ok,err = pcall(function() fn(args) end)
                    if not ok then notify("Erro: "..tostring(err)) end
                else
                    notify("Comando indisponível: "..command)
                end
            end
        end
    end
end
