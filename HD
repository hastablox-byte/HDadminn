local function runCommand(name, suppliedArgument)
    local arg=(suppliedArgument or ""):match("^%s*(.-)%s*$")
    local defaults={speed="50",jump="100",headsize="2",size="2",title="ADMIN",vehiclespeed="100"}
    if arg=="" then arg=defaults[name:lower()] or "" end
    local fn=commands[name:lower()]
    if fn then
        local args={";"..name:lower(),"me"}
        if arg~="" then table.insert(args,arg) end
        local ok,err=pcall(function() fn(args) end)
        if not ok then notify("Erro: "..tostring(err)) end
    end
end

local function openCommandPrompt(name)
    pendingCommand=name
    promptTitle.Text=string.upper(name)
    if name:lower()=="view" or name:lower()=="teleport" or name:lower()=="goto" then
        promptInput.PlaceholderText="Player username or display name..."
        promptInput.Text=""
    elseif name:lower()=="vehiclespeed" then
        promptInput.PlaceholderText="Vehicle speed (e.g. 100)"
        promptInput.Text="100"
    else
        promptInput.PlaceholderText="Enter value..."
        promptInput.Text=""
    end
    promptPanel.Visible=true
    promptInput:CaptureFocus()
end

local function submitPrompt()
    if not pendingCommand then return end
    local value=promptInput.Text
    if (pendingCommand:lower()=="view" or pendingCommand:lower()=="teleport" or pendingCommand:lower()=="goto") and value:match("^%s*$") then
        notify("Digite o nome de um jogador")
        return
    end
    local commandName=pendingCommand
    pendingCommand=nil
    promptPanel.Visible=false
    runCommand(commandName,value)
end
promptRun.MouseButton1Click:Connect(submitPrompt)
promptCancel.MouseButton1Click:Connect(function()
    pendingCommand=nil
    promptPanel.Visible=false
end)
promptInput.FocusLost:Connect(function(enterPressed)
    if enterPressed and promptPanel.Visible then submitPrompt() end
end)
